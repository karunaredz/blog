# ==============================================================================
# stratifyR 2.0  —  Launch Script
# ------------------------------------------------------------------------------
# Opens the stratifyR Shiny app in a borderless, desktop-style window.
#   - In RStudio : open this file and click "Source".
#   - Terminal   : Rscript "run_app.R"
#
# The app is launched through stratifyR::stratifyRApp() — the SAME entry point
# an installed user calls — so the developer launch and the shipped app run
# identical code. No absolute paths are hardcoded: if this script is run from
# inside the package source tree (with the sibling stratifyR 2.0-2/ folder next
# to it), stratifyR is reinstalled from source first so local edits take effect
# immediately; otherwise the already-installed copy of stratifyR is used.
# ==============================================================================
# -- Locate this script (so we can find the package source, if present) --------
.script_dir <- local({
args <- commandArgs(trailingOnly = FALSE)
fa   <- grep("^--file=", args, value = TRUE)
if (length(fa))
return(dirname(normalizePath(sub("^--file=", "", fa[1]))))
of <- tryCatch(sys.frames()[[1]]$ofile, error = function(e) NULL)
if (!is.null(of))
return(dirname(normalizePath(of)))
getwd()
})
# -- Install required packages if missing --------------------------------------
required <- c("shiny", "bslib", "DT", "plotly", "readxl", "ggplot2")
missing  <- required[!vapply(required, requireNamespace, logical(1), quietly = TRUE)]
if (length(missing) > 0) {
message("Installing missing packages: ", paste(missing, collapse = ", "))
install.packages(missing)
}
# -- Make sure stratifyR is available ------------------------------------------
# If a source tree sits next to this script, reinstall from source (dev mode)
# so edits to the package and the bundled app take effect. Otherwise fall back
# to whatever copy of stratifyR is already installed.
.pkg_src <- normalizePath(file.path(.script_dir, "..", "stratifyR 2.0-2"),
mustWork = FALSE)
if (dir.exists(.pkg_src)) {
message("Reinstalling stratifyR from source: ", .pkg_src)
install.packages(.pkg_src, repos = NULL, type = "source")
} else if (!requireNamespace("stratifyR", quietly = TRUE)) {
stop("stratifyR is not installed, and no package source was found next to ",
"this script.\nInstall it first with install.packages(\"stratifyR\").",
call. = FALSE)
}
# -- App-window launcher -------------------------------------------------------
# Uses Chrome/Brave/Edge --app mode to open a borderless standalone window
# that looks and feels like a native desktop application.
.open_app_window <- function(url) {
sysname  <- Sys.info()[["sysname"]]
app_args <- c(paste0("--app=", url),
"--window-size=1420,900",
"--window-position=60,40")
if (sysname == "Darwin") {
browsers <- c(
"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
"/Applications/Brave Browser.app/Contents/MacOS/Brave Browser",
"/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge",
"/Applications/Chromium.app/Contents/MacOS/Chromium"
)
for (b in browsers) {
if (file.exists(b)) {
message("Opening stratifyR 2.0 in app window via: ", basename(dirname(dirname(b))))
system2(b, args = app_args, wait = FALSE, stderr = FALSE)
return(invisible(NULL))
}
}
message("No Chromium-based browser found — opening in default browser.")
utils::browseURL(url)
} else if (sysname == "Windows") {
chrome_paths <- c(
file.path(Sys.getenv("PROGRAMFILES"),       "Google/Chrome/Application/chrome.exe"),
file.path(Sys.getenv("PROGRAMFILES(X86)"),  "Google/Chrome/Application/chrome.exe"),
file.path(Sys.getenv("LOCALAPPDATA"),        "Google/Chrome/Application/chrome.exe"),
file.path(Sys.getenv("PROGRAMFILES"),        "BraveSoftware/Brave-Browser/Application/brave.exe"),
file.path(Sys.getenv("PROGRAMFILES(X86)"),   "Microsoft/Edge/Application/msedge.exe")
)
for (p in chrome_paths) {
if (file.exists(p)) {
args_str <- paste(app_args, collapse = " ")
shell(sprintf('"%s" %s', p, args_str), wait = FALSE)
return(invisible(NULL))
}
}
message("No Chromium-based browser found — opening in default browser.")
utils::browseURL(url)
} else {
# Linux
for (cmd in c("google-chrome", "chromium-browser", "chromium", "brave-browser")) {
if (nzchar(Sys.which(cmd))) {
args_str <- paste(app_args, collapse = " ")
system(paste(cmd, args_str, "&"), wait = FALSE)
return(invisible(NULL))
}
}
utils::browseURL(url)
}
}
# -- Launch through the package's own entry point ------------------------------
message("\n  +--------------------------------------+")
message("  |   stratifyR 2.0  |  Starting app...  |")
message("  +--------------------------------------+\n")
stratifyR::stratifyRApp(port = 7734, launch.browser = .open_app_window)
stratifyRApp()
devtools::load_all("~/Desktop/strataVerse/stratifyR 2.0/stratifyR 2.0-3")
stratifyRApp()
install.packages("remotes")   # only needed once
remotes::install_github("karunaredz/stratifyR")
stratifyRApp()
